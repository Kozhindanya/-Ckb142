#include <stdio.h>
#include <math.h>
int main() 
{
    double x=0.61;
    double y=0.9;
    double z=0.3;

    double a=(pow(z,2*x)+pow(y,-x)*cos(z+y)*x)/(x+1);
    double b=sqrt(pow(x,2)+y)-pow(y,2)*pow(sin((x+z)/x),3);

    printf("x = %.3f\n", x);
    printf("y = %.3f\n", y);
    printf("z = %.3f\n", z);
    printf("a = %.3f\n", a);
    printf("b = %.3f\n", b);

    return 0;
}
